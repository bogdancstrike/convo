# Convo admin console origin (e.g. convo-admin.doncik.ro). Serves the console, the admin API and
# the Convo realm's sign-in pages — nothing else. The messenger API, Keycloak's admin and account
# consoles and the master realm are not reachable here.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    # Generated at start (20-admin-config.sh): TLS on 443 (Compose) or plain HTTP behind an ingress.
    include /etc/nginx/convo/listen.conf;
    server_tokens off;
    root /usr/share/nginx/html;
    include /etc/nginx/convo/resolver.conf;

    # Admin API only.
    location /v1/admin/ {
        set $upstream_server http://${UPSTREAM_SERVER};
        proxy_pass $upstream_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto $convo_proto;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /v1/ { return 404; }
    location /actuator/ { return 404; }

    # Sign-in for the Convo realm (OIDC, login pages, theme resources). Consoles are refused.
    location ^~ /auth/admin/ { return 404; }
    location ^~ /auth/realms/master/ { return 404; }
    location ~ ^/auth/realms/[^/]+/account(/|$) { return 404; }
    location = /auth/convo/admin {
        try_files /index.html =404;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/convo/headers.conf;
    }
    location /auth/ {
        set $upstream_keycloak http://${UPSTREAM_KEYCLOAK};
        proxy_pass $upstream_keycloak;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto $convo_proto;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/convo/headers.conf;
    }
}
