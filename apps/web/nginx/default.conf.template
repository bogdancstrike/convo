# Enclave web origin: serves the SPA and proxies API, WebSocket and Keycloak so everything is
# same-origin (no CORS, exact-origin WebSocket checks, simple CSP).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # Generated at start (20-convo-config.sh): TLS on 443 (Compose) or plain HTTP behind an ingress
    # that terminates TLS (Kubernetes, CONVO_TLS=off); also sets $convo_proto.
    include /etc/nginx/convo/listen.conf;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 2m;
    # Re-resolve service names (container DNS) so a recreated container is reached without restarting
    # nginx; upstreams are set through variables below for that reason.
    include /etc/nginx/convo/resolver.conf;
    # Keycloak's admin console is not served on the public origin when CONVO_KEYCLOAK_ADMIN=off.
    include /etc/nginx/convo/keycloak-admin.conf;

    # Backend API
    location /v1/ws {
        set $upstream_server http://${UPSTREAM_SERVER};
        proxy_pass $upstream_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto $convo_proto;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # LiveKit signalling (calls). Media is UDP to CONVO_SERVER_IP, end-to-end encrypted.
    location /rtc {
        set $upstream_livekit http://${UPSTREAM_LIVEKIT};
        proxy_pass $upstream_livekit;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /v1/ {
        set $upstream_server http://${UPSTREAM_SERVER};
        proxy_pass $upstream_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto $convo_proto;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Encrypted attachment objects (presigned S3 URLs). Host is preserved because it is part of
    # the SigV4 signature; bodies are streamed, never buffered to disk.
    location /enclave-attachments/ {
        set $upstream_seaweedfs http://${UPSTREAM_S3};
        proxy_pass $upstream_seaweedfs;
        proxy_set_header Host $http_host;
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /actuator/ {
        return 404;
    }

    # Exact browser callback belongs to the SPA, not Keycloak. The admin console has its own origin
    # (apps/admin); /admin is not served here.
    location ~ ^/(admin|auth/convo/admin)(/|$) { return 404; }
    location = /auth/convo/callback {
        try_files /index.html =404;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    }
    # Landing page after Keycloak's passkey registration (opened from Settings in a new tab).
    location = /auth/convo/passkey-done {
        try_files /passkey-done.html =404;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location = /https-required.html {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'" always;
    }

    # Organization identity provider
    location /auth/ {
        set $upstream_keycloak http://${UPSTREAM_KEYCLOAK};
        proxy_pass $upstream_keycloak;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Proto $convo_proto;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Fingerprinted static assets
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Bundled sticker packs: real 404s (no SPA fallback); clients verify each file's SHA-256 anyway.
    location /stickers/ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Android App Links: lets https://<host>/call/<token> open Convo directly (rendered at start).
    location = /.well-known/assetlinks.json {
        default_type application/json;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    # SPA shell with strict security headers (specs §28)
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
    }
}

# Plain HTTP deliberately serves an explanation before any crypto or sign-in is attempted
# (direct TLS mode; behind an ingress the ingress owns port 80).
server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    location = /logo.svg { }
    location / { try_files /https-required.html =404; }
}

# Internal, read-only health document. This port is not published on the host.
server {
    listen 8081;
    server_tokens off;
    root /usr/share/nginx/html;
    location = /healthz { access_log off; try_files /index.html =503; }
    location / { return 404; }
}
