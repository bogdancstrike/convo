# Copy to .env to override docker-compose.yaml defaults (development only).
ENCLAVE_HTTP_PORT=8088
CONVO_HTTPS_PORT=8443
CONVO_HTTPS_STANDARD_PORT=443
CONVO_HOSTNAME=convo.doncik.ro
# Required: this host's LAN address (LiveKit/coturn advertise it for call media).
CONVO_SERVER_IP=
# Maximum original file size in MiB. Encryption tags and size padding are allowed separately.
CONVO_ATTACHMENT_MAX_MB=100
# This is the canonical account issuer; keep stable after first enrollment.
OIDC_ISSUER=http://localhost:8088/auth/realms/enclave
ENCLAVE_PUBLIC_URL=http://localhost:8088
ENCLAVE_DEPLOYMENT_ID=enclave-dev
ENCLAVE_DISPLAY_NAME=Convo
ENCLAVE_DB_PORT=5433
ENCLAVE_DB_PASSWORD=enclave-dev-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
PGADMIN_PORT=5050
PGADMIN_PASSWORD=admin-dev-password
# Secret of the read-only Keycloak client convo-credential-status (passkey status for app locks).
# Generate with: openssl rand -hex 32. Empty keeps passkey status 'unavailable'.
CONVO_CREDENTIAL_STATUS_SECRET=
# Calls: LiveKit API secret (>= 32 chars) shared by the server and LiveKit, and the coturn password.
CONVO_LIVEKIT_SECRET=
CONVO_TURN_PASSWORD=
# Admin console: secret of the convo-admin-ops Keycloak client (sign-in account management).
CONVO_ADMIN_OPS_SECRET=
