# Copy to .env to override docker-compose.yaml defaults (development only).
ENCLAVE_HTTP_PORT=8088
CONVO_HTTPS_PORT=8443
# This is the canonical account issuer; keep stable after first enrollment.
OIDC_ISSUER=http://localhost:8088/auth/realms/enclave
ENCLAVE_PUBLIC_URL=http://localhost:8088
ENCLAVE_DEPLOYMENT_ID=enclave-dev
ENCLAVE_DISPLAY_NAME=Convo
ENCLAVE_DB_PORT=5433
ENCLAVE_DB_PASSWORD=enclave-dev-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
PGADMIN_PORT=5050
PGADMIN_PASSWORD=admin-dev-password
