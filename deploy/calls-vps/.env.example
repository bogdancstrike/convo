# Copy to .env (never commit it) and fill in.
# Public IPv4 of this VPS: offered to phones as the media address.
PUBLIC_IP=31.97.192.121
# DNS-only (grey cloud) A records pointing at PUBLIC_IP.
RTC_DOMAIN=rtc.doncik.ro
TURN_DOMAIN=turn.doncik.ro
# Let's Encrypt account e-mail (optional).
ACME_EMAIL=
# Must equal the Convo server's ENCLAVE_CALLS_API_SECRET (Kubernetes secret convo-livekit/api-secret).
LIVEKIT_API_KEY=convo
LIVEKIT_API_SECRET=
# TURN password for user "convo" (any long random string), e.g. `openssl rand -hex 24`.
TURN_PASSWORD=
MAX_PARTICIPANTS=16
