{
  "realm": "enclave",
  "eventsEnabled": true,
  "eventsExpiration": 0,
  "enabledEventTypes": [],
  "displayName": "Convo (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppFreeOTPName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "webAuthnPolicyPasswordlessRpEntityName": "Convo",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ro"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "enclave-web",
      "name": "Convo web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "/convo/callback",
        "/convo/passkey-done"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "phone"
      ],
      "rootUrl": "${authBaseUrl}"
    },
    {
      "clientId": "convo-integration",
      "name": "Convo archive/bot runtime",
      "description": "Device sign-in (RFC 8628) for archive and bot accounts run by deploy/convo-bot; no browser redirects, no password grant.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "phone", "basic", "email"]
    },
    {
      "clientId": "convo-android",
      "name": "Convo Android",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "com.convo.android:/oauth2redirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "phone",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "email",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
